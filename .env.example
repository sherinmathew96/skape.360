# SKAPE360 settings. This file stays on your computer and is never committed.

# --- Database -------------------------------------------------------------
# Leave empty to use the built-in local database (stored in .data/).
# For Supabase: Project settings > Database > Connection string > "Transaction pooler".
DATABASE_URL=

# --- First admin account --------------------------------------------------
# Used once, when the database is empty. Change these before going live.
SEED_ADMIN_NAME=Studio Admin
SEED_ADMIN_EMAIL=admin@studioskape.test
SEED_ADMIN_PASSWORD=

# --- Studio ---------------------------------------------------------------
APP_TIMEZONE=Asia/Kolkata

# --- File storage (Cloudflare R2) -----------------------------------------
# Leave empty to keep files in .data/uploads on this computer (development only).
# Cloudflare dashboard > R2 > your bucket; API token with Object Read & Write.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Public address -------------------------------------------------------
# The address clients use, e.g. https://app.studioskape.com. Used in share
# links and embed codes. Leave empty while testing locally.
APP_URL=
