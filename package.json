{
  "name": "skape360",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3360",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env.local scripts/db.mts migrate",
    "db:seed": "tsx --env-file=.env.local scripts/db.mts seed",
    "db:reset": "node -e \"require('fs').rmSync('.data',{recursive:true,force:true})\"",
    "db:check": "tsx --env-file=.env.local scripts/check.mts",
    "db:unlock": "tsx --env-file=.env.local scripts/clear-lockout.mts",
    "db:set-password": "tsx --env-file=.env.local scripts/set-password.mts",
    "r2:check": "tsx --env-file=.env.local scripts/check-r2.mts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1167.0",
    "@aws-sdk/s3-request-presigner": "^3.1167.0",
    "@electric-sql/pglite": "^0.5.16",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@google/model-viewer": "^4.4.0",
    "@photo-sphere-viewer/core": "^5.15.1",
    "@photo-sphere-viewer/markers-plugin": "^5.15.1",
    "@photo-sphere-viewer/virtual-tour-plugin": "^5.15.1",
    "@vercel/functions": "^3.11.2",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.72.0",
    "meshoptimizer": "^1.3.0",
    "next": "16.4.6",
    "pdfjs-dist": "^5.7.284",
    "pg": "^8.23.1",
    "postgres": "^4.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "three": "^0.183.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
